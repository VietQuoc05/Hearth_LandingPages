---
import { siteConfig } from '../data/siteContent';
---

<section class="content-band-light" id="tin-tuc">
  <div class="container">
    <div class="news-top-bar">
      <div class="section-header" style="margin-bottom: 0;">
        <div class="eyebrow-uppercase">
          <span class="eyebrow-dot"></span>
          <span>{siteConfig.newsSection.eyebrow}</span>
        </div>
        <h2 class="text-display-lg">
          {siteConfig.newsSection.headline}
        </h2>
      </div>

      <a href={siteConfig.newsSection.cta.href} class="btn btn-tertiary">
        {siteConfig.newsSection.cta.label}
      </a>
    </div>

    <!-- 3 Latest News Cards -->
    <div class="news-grid">
      {
        siteConfig.newsSection.articles.map((article, idx) => (
          <article class="news-card card-feature-cream">
            <!-- Framed Illustrative Graphic (per DESIGN-zapier.md Image Behavior) -->
            <div class="news-thumb">
              {idx === 0 && (
                <svg viewBox="0 0 360 180" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect width="360" height="180" rx="8" fill="#201515" />
                  <rect x="44" y="42" width="110" height="96" rx="12" fill="#FFFEFB" />
                  <path d="M99 64L130 90V120H68V90L99 64Z" fill="#201515" />
                  <rect x="91" y="98" width="16" height="22" fill="#FF4F00" />
                  <rect x="176" y="54" width="140" height="14" rx="4" fill="#FF4F00" />
                  <rect x="176" y="80" width="120" height="10" rx="4" fill="#F8F4F0" />
                  <rect x="176" y="100" width="96" height="10" rx="4" fill="#939084" />
                </svg>
              )}
              {idx === 1 && (
                <svg viewBox="0 0 360 180" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect width="360" height="180" rx="8" fill="#FFFEFB" stroke="#C5C0B1" />
                  <rect x="48" y="38" width="264" height="104" rx="8" fill="#F8F4F0" stroke="#201515" stroke-width="1.5" />
                  <circle cx="96" cy="90" r="26" fill="#FF4F00" />
                  <path d="M88 90L94 96L106 84" stroke="#FFFEFB" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                  <rect x="142" y="66" width="136" height="12" rx="4" fill="#201515" />
                  <rect x="142" y="88" width="112" height="10" rx="4" fill="#605D52" />
                  <rect x="142" y="106" width="84" height="10" rx="4" fill="#939084" />
                </svg>
              )}
              {idx === 2 && (
                <svg viewBox="0 0 360 180" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect width="360" height="180" rx="8" fill="#F8F4F0" stroke="#C5C0B1" />
                  <rect x="52" y="34" width="256" height="112" rx="8" fill="#201515" />
                  <rect x="86" y="72" width="44" height="74" fill="#FF4F00" />
                  <rect x="156" y="54" width="48" height="92" fill="#FF4F00" />
                  <rect x="230" y="72" width="44" height="74" fill="#FF4F00" />
                </svg>
              )}
            </div>

            <div class="news-meta-row">
              <span
                class:list={[
                  'badge-pill',
                  article.category === 'Thông cáo báo chí'
                    ? 'badge-pill-orange'
                    : 'badge-pill-outline',
                ]}
              >
                {article.category}
              </span>
              <time class="text-caption">{article.date}</time>
            </div>

            <h3 class="text-display-sub-sm news-card-title">
              <a
                href={article.slug}
                target={article.slug.startsWith('http') ? '_blank' : undefined}
                rel={article.slug.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                {article.title}
              </a>
            </h3>

            <p class="text-body-sm news-summary">
              {article.summary}
            </p>

            <div class="news-footer">
              <a
                href={article.slug}
                target={article.slug.startsWith('http') ? '_blank' : undefined}
                rel={article.slug.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="news-read-more"
              >
                <span>Đọc chi tiết</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .news-top-bar {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-xl);
    margin-bottom: var(--space-2xl);
  }

  @media (min-width: 900px) {
    .news-top-bar {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  .news-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 900px) {
    .news-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .news-card {
    border: 1px solid var(--color-mute);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    transition: border-color 0.18s ease, transform 0.18s ease;
  }

  .news-card:hover {
    border-color: var(--color-ink);
    transform: translateY(-2px);
  }

  .news-thumb svg {
    width: 100%;
    height: auto;
    border-radius: var(--rounded-sm);
  }

  .news-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .news-card-title a:hover {
    color: var(--color-primary);
  }

  .news-summary {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
  }

  .news-footer {
    padding-top: var(--space-xs);
  }

  .news-read-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14.4px;
    font-weight: 700;
    color: var(--color-ink);
  }

  .news-read-more:hover {
    color: var(--color-primary);
    gap: 10px;
  }
</style>

