---
import { siteConfig } from '../data/siteContent';
---

<section class="content-band-cream" id="san-pham">
  <div class="container">
    <!-- Section Header -->
    <div class="section-header">
      <div class="eyebrow-uppercase">
        <span class="eyebrow-dot"></span>
        <span>{siteConfig.productSection.eyebrow}</span>
      </div>
      <h2 class="text-display-lg">
        {siteConfig.productSection.headline}
      </h2>
      <p class="text-body-lg">
        {siteConfig.productSection.description}
      </p>
    </div>

    <!-- Flagship Product Showcase Banner: HOMERS (Clicking logo/banner opens https://property-marketplace-website.vercel.app/) -->
    <div class="homers-flagship-banner">
      <div class="homers-brand-block">
        <a
          href={siteConfig.product.url}
          target="_blank"
          rel="noopener noreferrer"
          class="homers-logo-link"
          aria-label="Mở trang web sản phẩm Homers"
        >
          <img
            src={siteConfig.product.logoPath}
            alt="Logo sản phẩm Homers"
            class="homers-main-logo"
            width="88"
            height="88"
          />
          <div class="homers-title-group">
            <h3 class="homers-product-name">{siteConfig.product.name}</h3>
            <p class="homers-product-sub">{siteConfig.product.tagline}</p>
          </div>
        </a>
      </div>

      <div class="homers-action-block">
        <a
          href={siteConfig.product.url}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          <span>Khám phá ngay</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M7 17L17 7M17 7H8M17 7V16" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>

        <div class="homers-secondary-row" aria-label="Nền tảng Homers & Đăng tin">
          <a
            href={siteConfig.product.url}
            target="_blank"
            rel="noopener noreferrer"
            class="secondary-inline-link"
          >
            Đăng tin miễn phí
          </a>

          <span class="dot-sep" aria-hidden="true">·</span>

          <div class="platform-icons-group">
            <a
              href={siteConfig.product.url}
              target="_blank"
              rel="noopener noreferrer"
              class="platform-icon-btn"
              title="Tải ứng dụng trên CH Play (Google Play)"
              aria-label="Tải ứng dụng trên CH Play"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3 20.5v-17c0-.83.94-1.3 1.6-.8l14 8.5c.6.37.6 1.23 0 1.6l-14 8.5c-.66.5-1.6.03-1.6-.8z" />
              </svg>
            </a>

            <a
              href={siteConfig.product.url}
              target="_blank"
              rel="noopener noreferrer"
              class="platform-icon-btn"
              title="Tải ứng dụng trên App Store"
              aria-label="Tải ứng dụng trên App Store"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.33c.64-.78 1.08-1.86.96-2.94-.93.04-2.06.62-2.72 1.4-.58.68-1.1 1.79-.96 2.84 1.04.08 2.08-.52 2.72-1.3z" />
              </svg>
            </a>

            <a
              href={siteConfig.product.url}
              target="_blank"
              rel="noopener noreferrer"
              class="platform-icon-btn"
              title="Truy cập website Homers"
              aria-label="Truy cập website Homers"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <line x1="2" y1="12" x2="22" y2="12" />
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- 4-Up Audience Grid (Người tìm nhà, Chủ nhà, Môi giới, Doanh nghiệp) -->
    <div class="audience-grid">
      {
        siteConfig.productSection.audiences.map((card) => (
          <article
            class:list={[
              'audience-card',
              card.featured ? 'card-feature-dark' : 'card-hairline',
            ]}
          >
            <div class="audience-card-top">
              <span
                class:list={[
                  'audience-role-tag',
                  card.featured ? 'role-tag-dark' : 'role-tag-light',
                ]}
              >
                Dành cho: {card.audience}
              </span>

              <a
                href={siteConfig.product.url}
                target="_blank"
                rel="noopener noreferrer"
                class="card-mini-homers"
                title="Trải nghiệm trên Homers"
              >
                <img
                  src={siteConfig.product.logoPath}
                  alt="Homers"
                  width="24"
                  height="24"
                />
              </a>
            </div>

            <h3
              class:list={[
                'text-display-sub-sm',
                'audience-card-title',
                { 'text-on-dark': card.featured },
              ]}
            >
              {card.title}
            </h3>

            <p
              class:list={[
                'text-body-sm',
                'audience-card-desc',
                { 'desc-on-dark': card.featured },
              ]}
            >
              {card.description}
            </p>

            <div class="audience-card-footer">
              <a
                href={siteConfig.product.url}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'audience-link',
                  { 'audience-link-dark': card.featured },
                ]}
              >
                <span>Truy cập</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .homers-flagship-banner {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-ink);
    border-radius: var(--rounded-md);
    padding: var(--space-2xl);
    margin-bottom: var(--space-2xl);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  @media (min-width: 900px) {
    .homers-flagship-banner {
      flex-direction: row;
      align-items: center;
    }
  }

  .homers-logo-link {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    group: true;
  }

  .homers-main-logo {
    width: 84px;
    height: 84px;
    border-radius: 18px;
    flex-shrink: 0;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .homers-logo-link:hover .homers-main-logo {
    transform: scale(1.05);
    box-shadow: 0 8px 20px rgba(32, 21, 21, 0.16);
  }

  .homers-title-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
    justify-content: center;
  }

  .homers-product-name {
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 38px);
    font-weight: 600;
    line-height: 1.1;
    color: var(--color-ink);
  }

  .homers-logo-link:hover .homers-product-name {
    color: var(--color-primary);
  }

  .homers-product-sub {
    font-size: 16px;
    color: var(--color-body);
  }

  .homers-action-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  @media (min-width: 900px) {
    .homers-action-block {
      align-items: flex-end;
    }
  }

  .homers-secondary-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    font-size: 15px;
    font-weight: 600;
  }

  .platform-icons-group {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .platform-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--rounded-md);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-mute);
    color: var(--color-ink);
    transition: all 0.16s ease;
  }

  .platform-icon-btn:hover {
    background-color: var(--color-ink);
    color: var(--color-on-primary);
    border-color: var(--color-ink);
    transform: translateY(-2px);
  }

  .secondary-inline-link {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .secondary-inline-link:hover {
    color: var(--color-primary);
  }

  .dot-sep {
    color: var(--color-body-mid);
  }

  /* 4-up Audience Grid */
  .audience-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 768px) {
    .audience-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1120px) {
    .audience-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .audience-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-lg);
    transition: transform 0.18s ease;
  }

  .audience-card:hover {
    transform: translateY(-3px);
  }

  .audience-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .audience-role-tag {
    font-size: 13px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--rounded-pill);
  }

  .role-tag-light {
    background-color: var(--color-canvas-soft);
    color: var(--color-ink);
  }

  .role-tag-dark {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }

  .card-mini-homers img {
    width: 26px;
    height: 26px;
    border-radius: 6px;
  }

  .audience-card-title {
    color: var(--color-ink);
  }

  .text-on-dark {
    color: var(--color-on-primary);
  }

  .audience-card-desc {
    flex-grow: 1;
  }

  .desc-on-dark {
    color: var(--color-mute);
  }

  .audience-card-footer {
    padding-top: var(--space-sm);
    border-top: 1px solid rgba(197, 192, 177, 0.35);
  }

  .audience-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14.4px;
    font-weight: 700;
    color: var(--color-primary);
  }

  .audience-link-dark {
    color: var(--color-on-primary);
  }

  .audience-link:hover {
    gap: 10px;
  }
</style>

