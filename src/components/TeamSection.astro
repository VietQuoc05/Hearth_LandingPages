---
import { siteConfig } from '../data/siteContent';
---

<section class="content-band-cream" id="doi-ngu">
  <div class="container">
    <div class="section-header">
      <div class="eyebrow-uppercase">
        <span class="eyebrow-dot"></span>
        <span>{siteConfig.teamSection.eyebrow}</span>
      </div>
      <h2 class="text-display-lg">
        Chúng tôi là <span class="highlight-bracket">[X]</span> con người đam mê, cùng làm mới cách người Việt tìm một mái nhà
      </h2>
      <p class="text-body-lg">
        {siteConfig.teamSection.description}
      </p>
    </div>

    <!-- 4 Member Cards: Portrait, Full Name, Title, One-sentence quote, and "Làm quen" button -->
    <div class="team-grid">
      {
        siteConfig.teamSection.members.map((member, index) => (
          <article class="team-card card-surface-canvas">
            <div class="member-header">
              <div class="member-avatar" aria-hidden="true">
                <span>{member.avatarInitials}</span>
              </div>
              <div class="member-meta">
                <span class="member-dept">{member.department}</span>
                <h3 class="text-display-xs member-name">{member.name}</h3>
                <p class="member-role">{member.role}</p>
              </div>
            </div>

            <blockquote class="member-quote">
              “{member.quote}”
            </blockquote>

            <div class="member-footer">
              <button
                type="button"
                class="btn-text member-connect-btn"
                data-member-index={index}
                data-member-name={member.name}
                data-member-role={member.role}
                data-member-quote={member.quote}
              >
                <span>Làm quen</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Interactive "Làm quen" Toast / Bio Preview -->
    <div class="member-preview-banner" id="member-preview-banner" hidden>
      <div class="preview-banner-content">
        <strong id="preview-member-title">Kết nối cùng thành viên Hearth</strong>
        <p id="preview-member-body" class="text-body-sm"></p>
      </div>
      <a href="#lien-he" class="btn btn-secondary" style="font-size: 14px; padding: 8px 16px; min-height: 38px;">
        Gửi lời chào
      </a>
    </div>

    <!-- Section Bottom CTA -->
    <div class="team-cta-row">
      <a href={siteConfig.teamSection.cta.href} class="btn btn-primary">
        <span>{siteConfig.teamSection.cta.label}</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  const connectBtns = document.querySelectorAll('.member-connect-btn');
  const previewBanner = document.getElementById('member-preview-banner');
  const previewTitle = document.getElementById('preview-member-title');
  const previewBody = document.getElementById('preview-member-body');

  connectBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const name = btn.getAttribute('data-member-name') || '';
      const role = btn.getAttribute('data-member-role') || '';
      const quote = btn.getAttribute('data-member-quote') || '';
      if (previewBanner && previewTitle && previewBody) {
        previewTitle.textContent = `Làm quen với ${name} (${role})`;
        previewBody.textContent = `Chia sẻ: "${quote}" — Bạn muốn trò chuyện hoặc ứng tuyển vào nhóm của ${name}? Hãy để lại lời nhắn bên dưới!`;
        previewBanner.removeAttribute('hidden');
      }
    });
  });
</script>

<style>
  .highlight-bracket {
    color: var(--color-primary);
  }

  .team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 768px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1120px) {
    .team-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .team-card {
    border: 1px solid var(--color-ink);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .member-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .member-avatar {
    width: 60px;
    height: 60px;
    border-radius: var(--rounded-full);
    background-color: var(--color-ink);
    color: var(--color-on-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    flex-shrink: 0;
    border: 2px solid var(--color-primary);
  }

  .member-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .member-dept {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .member-name {
    color: var(--color-ink);
  }

  .member-role {
    font-size: 14px;
    color: var(--color-body);
  }

  .member-quote {
    font-size: 16px;
    line-height: 24px;
    color: var(--color-ink-mid);
    font-style: normal;
    background-color: var(--color-canvas-soft);
    padding: var(--space-md);
    border-radius: var(--rounded-sm);
    flex-grow: 1;
  }

  .member-footer {
    display: flex;
    justify-content: flex-start;
  }

  .member-preview-banner {
    margin-top: var(--space-xl);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-primary);
    border-radius: var(--rounded-md);
    padding: var(--space-lg) var(--space-xl);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .preview-banner-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 820px;
  }

  .team-cta-row {
    margin-top: var(--space-2xl);
    display: flex;
    justify-content: flex-start;
  }
</style>

