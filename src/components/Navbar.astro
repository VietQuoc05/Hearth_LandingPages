---
import { siteConfig } from '../data/siteContent';
---

<header class="site-navbar">
  <div class="container navbar-inner">
    <!-- Brand Logo: Hearth -->
    <a href="#" class="brand-logo" aria-label="Hearth Trang chủ">
      <img
        src="/images/hearth-logo.png"
        alt="Hearth Logo"
        class="brand-logo-img"
        width="148"
        height="32"
      />
    </a>

    <!-- Navigation Links -->
    <nav class="nav-links" aria-label="Thanh điều hướng chính">
      {
        siteConfig.navItems.map((item) => (
          <div class="nav-item-wrapper">
            <a href={item.href} class="nav-link">
              {item.label}
            </a>
            <div class="nav-tooltip" role="tooltip">
              <span class="nav-tooltip-title">{item.label}</span>
              <span class="nav-tooltip-desc">{item.description}</span>
            </div>
          </div>
        ))
      }
    </nav>

    <!-- Empty Spacer to symmetrically balance the Logo and keep nav-links perfectly centered -->
    <div class="nav-spacer" aria-hidden="true"></div>
  </div>
</header>

<style>
  .site-navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(255, 254, 251, 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-mute);
    padding: var(--space-sm) 0;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    padding: 2px 0;
  }

  .brand-logo-img {
    height: 32px;
    width: auto;
    object-fit: contain;
    transition: transform 0.2s ease;
  }

  @media (max-width: 640px) {
    .brand-logo-img {
      height: 26px;
    }
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .nav-spacer {
    display: none;
  }

  @media (min-width: 768px) {
    .navbar-inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }

    .brand-logo {
      justify-self: start;
    }

    .nav-links {
      display: flex;
      justify-self: center;
    }

    .nav-spacer {
      display: block;
      justify-self: end;
    }
  }

  @media (max-width: 767px) {
    .navbar-inner {
      flex-direction: column;
      justify-content: center;
      gap: var(--space-xs);
    }

    .nav-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 2px;
    }

    .nav-link {
      font-size: 13px;
      padding: 4px 8px;
    }
  }

  .nav-item-wrapper {
    position: relative;
  }

  .nav-link {
    position: relative;
    display: inline-block;
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
    color: var(--color-ink);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--rounded-sm);
    overflow: hidden;
    transition: color 0.18s ease, background-color 0.18s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background-color: var(--color-primary);
    opacity: 0;
    transform: scaleX(0);
    transform-origin: center;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .nav-item-wrapper:hover .nav-link,
  .nav-link:hover,
  .nav-link:focus-visible {
    background-color: var(--color-canvas-soft);
    color: var(--color-primary);
  }

  .nav-item-wrapper:hover .nav-link::after,
  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .nav-tooltip {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    width: 240px;
    background-color: var(--color-ink);
    color: var(--color-on-primary);
    padding: var(--space-md);
    border-radius: var(--rounded-md);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.16s ease, transform 0.16s ease;
    display: flex;
    flex-direction: column;
    gap: 4px;
    z-index: 20;
  }

  .nav-item-wrapper:hover .nav-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .nav-tooltip-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .nav-tooltip-desc {
    font-size: 13px;
    line-height: 18px;
    color: var(--color-canvas-soft);
  }
</style>
